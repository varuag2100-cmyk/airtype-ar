------MultipartBoundary--OtaYtULTvE2eyHfixi5RRO02Xx7cFApRTw8A713M7f----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://airtype-ar-app.netlify.app/styles.css

@charset "utf-8";

:root { --bg: #04080d; --surface: rgba(13, 23, 34, 0.78); --surface-2: rgba(20, 34, 48, 0.9); --line: rgba(120, 220, 255, 0.16); --line-strong: rgba(120, 220, 255, 0.36); --cyan: #38e8ff; --cyan-rgb: 56 232 255; --text: #e8f5fb; --muted: #93abba; --warn: #ffc45c; --danger: #ff6b7a; --ok: #5cf2a5; --radius: 18px; --font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif; --mono: ui-monospace, 'SFMono-Regular', 'Roboto Mono', Menlo, monospace; --kb-x: 50%; --kb-y: 70%; --kb-w: 94%; --kb-h: 42%; --kb-o: 0.55; --kb-gap: 4px; }

* { box-sizing: border-box; }

html, body { margin: 0px; height: 100%; background: var(--bg); color: var(--text); font-family: var(--font); -webkit-tap-highlight-color: transparent; overflow: hidden; overscroll-behavior: none; }

button, input, select, textarea { font: inherit; color: inherit; }

button { cursor: pointer; }

svg { width: 1em; height: 1em; flex: 0 0 auto; }

[hidden] { display: none !important; }

.app { height: 100dvh; display: grid; grid-template-rows: auto minmax(0px, 1fr) auto; grid-template-areas: "top" "work" "editor"; gap: 8px; padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); max-width: 100vw; overflow: hidden; background: radial-gradient(120% 60% at 50% -10%, rgba(56, 232, 255, 0.12), transparent 60%),
    var(--bg); }

.topbar { grid-area: top; display: flex; align-items: center; gap: 10px; padding: 8px 10px 0px; min-width: 0px; }

.brand { display: flex; align-items: center; gap: 8px; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap; }

.brand img { border-radius: 8px; }

.brand b { color: var(--cyan); font-weight: 700; }

.status { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 0.8rem; min-width: 0px; white-space: nowrap; overflow: hidden; }

.status__text { overflow: hidden; text-overflow: ellipsis; }

.status__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); flex: 0 0 auto; transition: background 0.2s; }

.status[data-tone="ok"] .status__dot { background: var(--ok); box-shadow: 0 0 10px var(--ok); }

.status[data-tone="active"] .status__dot { background: var(--cyan); box-shadow: 0 0 10px var(--cyan); animation: 1.6s ease 0s infinite normal none running pulse; }

.status[data-tone="warn"] .status__dot { background: var(--warn); }

.status[data-tone="error"] .status__dot { background: var(--danger); }

@keyframes pulse { 
  50% { opacity: 0.45; }
}

.icon-btn { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); font-size: 20px; flex: 0 0 auto; }

.icon-btn--sm { width: 40px; height: 40px; border-radius: 12px; font-size: 18px; }

.icon-btn:disabled { opacity: 0.4; cursor: default; }

.icon-btn[aria-pressed="true"] { border-color: var(--cyan); color: var(--cyan); }

.icon-btn--danger { color: rgb(255, 179, 187); }

.icon-btn:focus-visible, .btn:focus-visible, .ctl:focus-visible, .key:focus-visible, .segmented button:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }

.workspace { grid-area: work; display: flex; flex-direction: column; gap: 8px; min-height: 0px; padding: 0px 10px; }

.stage { position: relative; flex: 1 1 0%; min-height: 0px; border-radius: var(--radius); overflow: hidden; background: rgb(2, 6, 10); border: 1px solid var(--line); touch-action: none; isolation: isolate; }

.stage video { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; z-index: 0; }

.stage video.is-mirrored { transform: scaleX(-1); }

.stage__grid { position: absolute; inset: 0px; z-index: 0; background-image: linear-gradient(rgba(56, 232, 255, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(56, 232, 255, 0.06) 1px, transparent 1px); background-size: 28px 28px; pointer-events: none; }

.stage.has-video .stage__grid { display: none; }

.stage__overlay { position: absolute; inset: 0px; z-index: 3; pointer-events: none; }

.keyboard { position: absolute; z-index: 2; left: var(--kb-x); top: var(--kb-y); width: var(--kb-w); height: var(--kb-h); transform: translate(-50%, -50%); display: flex; flex-direction: column; gap: var(--kb-gap); padding: var(--kb-gap); border-radius: 16px; background: rgb(4 10 16 / calc(var(--kb-o) * 0.35)); border: 1px solid rgb(var(--cyan-rgb) / calc(var(--kb-o) * 0.4)); pointer-events: none; user-select: none; }

.keyboard.is-touch { pointer-events: auto; }

.kb-row { flex: 1 1 0%; display: flex; gap: var(--kb-gap); min-height: 0px; }

